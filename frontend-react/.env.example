# ==============================================================================
# ForenSOC Frontend — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- API Configuration ---
# Local development: leave as default (Vite dev server proxies /api → backend)
# Production (Vercel/Netlify): set to your deployed backend URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Request timeout in milliseconds
VITE_API_TIMEOUT=30000

# --- App Metadata ---
VITE_APP_NAME=ForenSOC
VITE_APP_VERSION=1.0.0

# --- Feature Flags ---
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# --- Public Search (optional override — only needed if different from VITE_API_BASE_URL) ---
# VITE_PUBLIC_API_URL=https://forensoc-backend.onrender.com/api

# --- WebSocket (only needed for split Vercel+Render deployments) ---
# When the frontend is on Vercel CDN and backend is on Render, WebSocket must connect
# directly to the backend root (not through Vercel). Set this to the backend URL root:
# VITE_SOCKET_URL=https://forensoc-backend.onrender.com
