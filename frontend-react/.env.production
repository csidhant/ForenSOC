# ==============================================================================
# ForenSOC Frontend — Production Environment
# Set these variables in your Vercel Dashboard:
#   Project Settings → Environment Variables → Production
#
# DO NOT commit this file with real secrets.
# ==============================================================================

# Backend API URL (your Render.com backend URL + /api)
VITE_API_BASE_URL=https://forensoc-backend.onrender.com/api

# Request timeout in ms
VITE_API_TIMEOUT=30000

# App metadata
VITE_APP_NAME=ForenSOC
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# WebSocket — for split deployments (Vercel frontend + Render backend)
# Set to your backend root URL (without /api) to allow direct WS connection
VITE_SOCKET_URL=https://forensoc-backend.onrender.com
