# ==============================================================================
# ForenSOC — Root Environment Template
# Used by docker-compose.yml to inject secrets into all containers.
# Copy to .env and fill in real values — NEVER commit .env to git.
# ==============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ForenSOCdb_ChangeMeNow!

# ── Backend Security ───────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-before-deploying

# ── Admin Account (created on first startup) ───────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@forensoc.local
ADMIN_PASSWORD=ForenSOC@2024!

# ── CORS — Add your public frontend URL after deploying ───────────────────────
# Example: https://forensoc.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS_STR=

# ── App Behaviour ──────────────────────────────────────────────────────────────
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Optional: Slack Notifications ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
