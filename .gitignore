# ==============================================================================
# ForenSOC — Root .gitignore
# ==============================================================================

# ── Environment / Secrets (NEVER commit these) ─────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
pip-wheel-metadata/
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# ── SQLite (dev only — use PostgreSQL in prod) ────────────────────────────────
*.db
*.sqlite3

# ── Uploads / Evidence / Forensic Files ──────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/ingest_drop/*
!backend/ingest_drop/.gitkeep

# ── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/
frontend-react/dist/
frontend-react/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel/

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# (docker-compose.yml and Dockerfiles are tracked, overrides are not)
docker-compose.override.yml

# ── Test Artifacts ────────────────────────────────────────────────────────────
test_*.db
backend/migrations/versions/__pycache__/
