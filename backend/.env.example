# ==============================================================================
# ForenSOC Backend — Production Environment Template
# Copy this to .env and fill in real values before deploying
# NEVER commit the actual .env file to git
# ==============================================================================

# --- Application ---
APP_NAME=ForenSOC
APP_VERSION=1.0.0
DEBUG=false

# --- Database ---
# Local development (SQLite):
DATABASE_URL=sqlite:///./forensoc.db
# Production (PostgreSQL — copy the connection string from Render/Railway):
# DATABASE_URL=postgresql://user:password@hostname:5432/forensoc

# --- Security (MUST CHANGE for production!) ---
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Add your deployed frontend URL here (comma-separated for multiple):
# Example: https://forensoc.vercel.app,https://forensoc.netlify.app
ALLOWED_ORIGINS_STR=

# --- Admin Account (created on first startup) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@forensoc.local
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000

# --- Optional: Slack Notifications ---
SLACK_WEBHOOK_URL=

# --- Optional: Redis + Celery (for async forensics) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Forensics Tool Paths (local tools, not available on cloud) ---
VOLATILITY_PATH=vol
ZEEK_PATH=zeek
YARA_PATH=yara
