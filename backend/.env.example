# ForenSOC Application Configuration
# Copy this file to .env and update with your settings

# Application
APP_NAME=ForenSOC
APP_VERSION=1.0.0
DEBUG=false
API_V1_STR=/api

# Database (uncomment for PostgreSQL, comment out SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/forensoc
# For SQLite MVP:
DATABASE_URL=sqlite:///./forensoc.db
DATABASE_ECHO=false

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@forensoc.local
ADMIN_PASSWORD=admin
DEFAULT_USER_ROLE=viewer

# CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:8501,http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5368709120

# Celery broker (async PCAP / memory jobs)
REDIS_URL=redis://127.0.0.1:6379/0
ZEEK_PATH=zeek
YARA_PATH=yara

# Detection thresholds
SSH_BRUTE_FORCE_THRESHOLD=5
SSH_BRUTE_FORCE_TIMEFRAME=120
PORT_SCAN_THRESHOLD=20
PORT_SCAN_TIMEFRAME=120
RANSOMWARE_FILE_THRESHOLD=30
RANSOMWARE_TIME_WINDOW=60
DATA_EXFILTRATION_THRESHOLD=1073741824
